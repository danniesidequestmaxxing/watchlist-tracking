# Telegram
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Data sources
TOKEN_UNLOCKS_API_KEY=
COINMARKETCAL_API_KEY=
FINNHUB_API_KEY=
TRADING_ECONOMICS_API_KEY=
TWELVE_DATA_API_KEY=
POLYGON_API_KEY=

# Korea DART (free signup at https://opendart.fss.or.kr/) — needed for /catalyst <KR_ticker>
DART_API_KEY=

# SEC EDGAR requires a User-Agent
SEC_EDGAR_UA="Dannie Sidequest dannie@example.com"

# Runtime
TIMEZONE=Asia/Kuala_Lumpur
LOG_LEVEL=INFO
DB_PATH=data/bot.db

# Phase 9 webhook ingress (optional). If WEBHOOK_TOKEN is empty, the bot does
# not start an HTTP listener. Configure TradingView to POST to
#   https://<host>:<WEBHOOK_PORT>/webhooks/tradingview/<WEBHOOK_TOKEN>
# Railway exposes its assigned port via the PORT env var, which WEBHOOK_PORT
# falls back to.
WEBHOOK_TOKEN=
WEBHOOK_PORT=
